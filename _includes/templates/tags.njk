---
layout: layout.njk
pagination:
  data: collections
  size: 1
  alias: tag
  filter: ['all', 'nav', 'post', 'posts']
  addAllPagesToCollections: true
permalink: "tags/{{ tag | slug }}/index.html"
---

<h1>Tag: {{ tag }}</h1>

<ul>
  {% for item in collections[tag] %}
    <li><a href="{{ item.url }}">{{ item.data.title }}</a></li>
  {% endfor %}
</ul>