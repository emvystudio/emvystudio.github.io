---
title: "Data Reference"
permalink: "/_reference/"
layout: null
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Eleventy Data Reference</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      padding: 2rem;
      line-height: 1.4;
    }
    h2 {
      margin-top: 3rem;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
      font-size: 0.85rem;
    }
    th, td {
      border: 1px solid #ccc;
      padding: 0.4rem 0.6rem;
      vertical-align: top;
      text-align: left;
    }
    th {
      background: #f5f5f5;
    }
    code {
      background: #eee;
      padding: 0.1rem 0.3rem;
    }
  </style>
</head>

<body>

<h1>Eleventy Data Reference</h1>

<p>
  Internal reference page.<br>
  Not linked anywhere. Safe to delete at any time.
</p>

<!-- ================= PROJECTS ================= -->

<h2>Projects</h2>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Category</th>
      <th>Tags</th>
      <th>Skills</th>
      <th>Roles</th>
      <th>URL</th>
    </tr>
  </thead>
  <tbody>
    {% for project in collections.projects %}
      <tr>
        <td>{{ project.data.title }}</td>
        <td>{{ project.data.category }}</td>
        <td>
          {% for tag in project.data.tags %}
            <code>{{ tag }}</code>{% if not loop.last %}, {% endif %}
          {% endfor %}
        </td>
        <td>
          {% for skill in project.data.skills %}
            <code>{{ skill }}</code>{% if not loop.last %}, {% endif %}
          {% endfor %}
        </td>
        <td>
          {% for role in project.data.roles %}
            <code>{{ role }}</code>{% if not loop.last %}, {% endif %}
          {% endfor %}
        </td>
        <td><code>{{ project.url }}</code></td>
      </tr>
    {% endfor %}
  </tbody>
</table>

<!-- ================= CATEGORIES ================= -->

<h2>Categories</h2>

<table>
  <thead>
    <tr>
      <th>Category</th>
      <th>Project Count</th>
    </tr>
  </thead>
  <tbody>
    {% for category, data in collections.categories %}
      <tr>
        <td>{{ category }}</td>
        <td>{{ data.items | length }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>

<!-- ================= TAGS ================= -->

<h2>Tags</h2>

<table>
  <thead>
    <tr>
      <th>Tag</th>
      <th>Usage Count</th>
    </tr>
  </thead>
  <tbody>
    {% for tag in collections.projects | allProjectTags %}
      <tr>
        <td><code>{{ tag }}</code></td>
        <td>{{ collections[tag] | length }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>

<!-- ================= SKILLS ================= -->

<h2>Skills</h2>

<table>
  <thead>
    <tr>
      <th>Skill Key</th>
      <th>Label</th>
      <th>Defined in Registry</th>
    </tr>
  </thead>
  <tbody>
    {% for key, meta in skillRegistry %}
      <tr>
        <td><code>{{ key }}</code></td>
        <td>{{ meta.label }}</td>
        <td>✔</td>
      </tr>
    {% endfor %}
  </tbody>
</table>

<!-- ================= ROLES ================= -->

<h2>Roles</h2>

<table>
  <thead>
    <tr>
      <th>Role</th>
    </tr>
  </thead>
  <tbody>
    {% for role in collections.projects | allRoles %}
      <tr>
        <td>{{ role }}</td>
      </tr>
    {% endfor %}
  </tbody>
</table>

</body>
</html>